# 敏感配置模板（P7-Dep2）
# ---------------------------------------------------------------------
# 用法：复制本文件为 secret.yaml，填入真实值后 kubectl apply。
#   cp secret.yaml.example secret.yaml
#   # 编辑 secret.yaml 填入 Key 与随机密钥
#   kubectl apply -f secret.yaml
#
# ⚠️ 切勿把填了真实值的 secret.yaml 提交到 git（.gitignore 已忽略）。
# 敏感值以 base64 存储：echo -n '值' | base64

apiVersion: v1
kind: Secret
metadata:
  name: knowagent-secret
  namespace: knowagent
type: Opaque
stringData:
  # 用 stringData 直接写明文，kubectl 会自动 base64（比手工 base64 更不易错）
  DEEPSEEK_API_KEY: "CHANGE_ME"
  QWEN_API_KEY: "CHANGE_ME"
  QWEN_EMBEDDING_BASE_URL: "https://ws-spooiga008ludcip.cn-beijing.maas.aliyuncs.com/api/v1/embeddings"
  # JWT 密钥：python -c "import secrets;print(secrets.token_urlsafe(48))"
  JWT_SECRET_KEY: "CHANGE_ME_RANDOM_48_BYTES"
  # 数据库口令（与 postgres.yaml 中 POSTGRES_PASSWORD 一致）
  POSTGRES_PASSWORD: "knowagent"
  # 数据库连接串（service 名 knowagent-postgres）
  DATABASE_URL: "postgresql+asyncpg://knowagent:knowagent@knowagent-postgres:5432/knowagent"
  # Celery / Redis
  CELERY_BROKER_URL: "redis://knowagent-redis:6379/0"
  CELERY_RESULT_BACKEND: "redis://knowagent-redis:6379/1"
  REDIS_CACHE_URL: "redis://knowagent-redis:6379/2"
  RATE_LIMIT_REDIS_URL: "redis://knowagent-redis:6379/2"
  # 数据不出域白名单（strict 模式下生效，逗号分隔）
  OUTBOUND_ALLOWED_HOSTS: ".deepseek.com,.aliyuncs.com"
  # /metrics 抓取令牌（公网暴露务必设置，并同步到 Prometheus 抓取配置）
  METRICS_TOKEN: "CHANGE_ME"
  # Sentry（可选；私有化通常留空关闭）
  SENTRY_DSN: ""
