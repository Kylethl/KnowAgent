# 前端开发环境变量
# 复制本文件为 .env 按需修改（.env 不入库）

# 对话接口地址（SSE /chat 的入口）
# 默认值 /api/chat：经 Vite 开发代理转发到后端 FastAPI（见 vite.config.ts 的 /api 反代）。
# 若需绕过代理直连后端，可改为 http://localhost:8000/chat
VITE_CHAT_API=/api/chat

# 文档上传接口地址（P1-F3 前端使用，对应后端 P1-B2 的 POST /documents/upload）
# 默认值 /api/documents/upload：同样经 Vite 代理剥前缀转发到后端
VITE_UPLOAD_API=/api/documents/upload

# 是否启用本地模拟上传（P1-F3 联调用）
# true  = 不发起真实网络请求，用定时器伪造进度与「待审核」回执，用于后端未就绪时验收前端 UI
# 不设置 / false = 走真实接口（后端 P1-B2 完成后使用此模式）
VITE_UPLOAD_MOCK=false
