# 后端环境变量示例（复制为 .env 后按需修改；.env 不入库，见 .gitignore）
#
# 用法：cp .env.example .env

# ---------- 服务基础 ----------
APP_NAME=KnowAgent API
APP_ENV=development
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ---------- CORS（逗号分隔；本地 Vite 开发服务器默认 5173） ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ---------- DeepSeek 大模型 ----------
# ⚠️ 替换为真实 Key 后方可真实问答；占位值会被识别为「未配置」并在 /chat 返回提示。
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 对话生成模型（按《需求清单》锁定 DeepSeek-V4.1-Flash）
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT=60

# ---------- 系统提示词 ----------
SYSTEM_PROMPT=你是「知识库问答」网站的智能助手，使用简洁、准确的中文回答用户问题。若你不掌握确定信息，请如实说明，不要编造。

# ---------- 会话记忆（P1 进程内临时实现） ----------
MEMORY_MAX_TURNS=10

# ---------- 日志 ----------
LOG_LEVEL=INFO
