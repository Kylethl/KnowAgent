# 后端环境变量示例（复制为 .env 后按需修改；.env 不入库，见 .gitignore）
#
# 用法：cp .env.example .env

# ---------- 服务基础 ----------
APP_NAME=KnowAgent API
APP_ENV=development
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ---------- CORS（逗号分隔；本地 Vite 开发服务器默认 5173） ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ---------- DeepSeek 大模型 ----------
# ⚠️ 替换为真实 Key 后方可真实问答；占位值会被识别为「未配置」并在 /chat 返回提示。
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 对话生成模型：《需求清单》锁定 DeepSeek-Flash。
# ⚠️ DeepSeek 在线 API 当前实际可用的模型为 deepseek-flash 与 deepseek-v4-pro
#   （需求文档中的 deepseek-v4.1-flash 无法调用），填写时以此为准。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT=60

# ---------- 系统提示词 ----------
SYSTEM_PROMPT=你是「知识库问答」网站的智能助手，使用简洁、准确的中文回答用户问题。若你不掌握确定信息，请如实说明，不要编造。

# ---------- 用户鉴权（P2-B2：JWT + bcrypt） ----------
# JWT 签名密钥：⚠️ 必须替换为随机长密钥后再启动，切勿使用下方占位值！
#   生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_INSECURE_DEV_SECRET
# 签名算法（对称密钥固定 HS256）
JWT_ALGORITHM=HS256
# 访问令牌有效期（分钟）：默认 1440 = 1 天
JWT_EXPIRE_MINUTES=1440
# 是否强制所有业务接口要求鉴权（P2-Dep1）。false = 回退 Demo 用户，仅供本地无库联调
AUTH_REQUIRED=true
# bcrypt 计算强度（cost factor）：12 为安全与性能的常用折中
BCRYPT_ROUNDS=12

# ---------- 会话记忆（P1-A1：LangChain 会话历史，进程内存） ----------
# 单会话保留的最大轮次（1 轮 = 用户 + 助手各 1 条），超出按窗口裁剪
MEMORY_MAX_TURNS=10
# 进程内最多保留多少个会话，超出按 LRU 淘汰，防止长期运行占满内存
MEMORY_MAX_SESSIONS=1000

# ---------- 数据库（PostgreSQL，P1-DB1 起） ----------
# 异步连接串（asyncpg 驱动）；默认指向本地 Docker Compose 的 PostgreSQL（见 P1-Dep1）
# 格式：postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://knowagent:knowagent@localhost:5432/knowagent
# 开发期是否打印 SQL（生产务必关闭）
DB_ECHO=false

# ---------- 知识库向量与入库（P3 功能2：RAG 管线） ----------
# 千问 Embedding（阿里云百炼 / DashScope）API Key。
# ⚠️ 留空或保持占位值时，embedding 走**确定性 mock 向量**：
#    入库管线（解析 → 切片 → 写向量）可完整跑通，但向量不具备语义相似度，
#    P4 真实检索前必须填入真实 Key。
QWEN_API_KEY=sk-REPLACE_ME
# 多模态向量接口地址（qwen3-vl-embedding）
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
QWEN_EMBEDDING_MODEL=qwen3-vl-embedding
# 向量维度：必须与 sql/004_p3_db2_vector.sql 的 vector(1024) 一致，改维度需重建表
EMBEDDING_DIM=1024
# 单批送检条数
EMBEDDING_BATCH_SIZE=6
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=2
# Embedding 接口协议：auto（按 BASE_URL 自动识别）/ openai（OpenAI 兼容网关，如百炼 compatible-mode）/ dashscope（原生多模态）
QWEN_EMBEDDING_API_MODE=auto
# 切片策略：目标字符数 / 相邻切片重叠字符数
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---------- 异步任务（P3-B2：Celery + Redis） ----------
# Redis 作为 broker 与结果后端（docker/docker-compose.dev.yml 已编排 redis 服务）
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 置 false 时（或 Redis 不可达）自动回退为「进程内后台任务」，本地无 Redis 也能入库
USE_CELERY=true

# ---------- RAG 检索增强（P4 功能1：/chat 检索增强） ----------
# 总开关：false 时 /chat 回到「无检索」的通用回答（便于对比与排障）
RAG_ENABLED=true
# 注入 Prompt 的资料条数（重排后的 Top-K）与粗排候选数（重排前）
RAG_TOP_K=5
RAG_CANDIDATE_K=20
# 余弦相似度下限：低于该值视为不相关直接丢弃。
# 默认 0.40 由 scripts/calibrate_rag_threshold.py 实测标定
# （无关切片噪声 p95≈0.48，真实相关问句 Top-1 落在 0.54~0.77）。
# ⚠️ 换 embedding 模型后必须重新标定：python scripts/calibrate_rag_threshold.py --apply-hint
RAG_SIMILARITY_THRESHOLD=0.40
# 注入 Prompt 的参考资料总字符预算（防上下文膨胀）
RAG_MAX_CONTEXT_CHARS=3000
# 轻量启发式重排（向量相似度 + 查询词覆盖率），无额外外部服务与费用
RAG_RERANK_ENABLED=true
# embedding 为 mock（未配置真实 QWEN_API_KEY）时是否仍执行检索。
# 默认 false：mock 向量无语义，检索结果等同随机，应标记为「检索未启用」。
RAG_ALLOW_MOCK_EMBEDDING=false

# 检索结果缓存（P4-DB1：高频命中缓存到 Redis；不可达时自动回退进程内缓存）
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=300
RAG_CACHE_MAX_ITEMS=256
RAG_CACHE_KEY_PREFIX=rag:retrieval:v1
# 缓存专用 Redis 库：与 Celery 的 db0/db1 隔离，互不干扰
REDIS_CACHE_URL=redis://localhost:6379/2

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- 对象存储与文件上传（P1-B2） ----------
# 存储后端：local（本地目录，开发免 MinIO）/ minio（MinIO / S3 兼容）
STORAGE_BACKEND=local
# local 后端落盘目录（相对 backend 根目录；生产可指向挂载卷）
STORAGE_LOCAL_DIR=data/uploads
# MinIO / S3 配置（STORAGE_BACKEND=minio 时启用；local 时忽略）
# 格式：host:port（不含 http:// 前缀，minio SDK 要求）
STORAGE_ENDPOINT=localhost:9000
STORAGE_BUCKET=knowagent
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
# 预签名 URL 有效期（秒），供后续下载/预览接口使用
STORAGE_PRESIGN_EXPIRE=3600
# 单文件上传大小上限（字节）：**仅文档类**（word/markdown），默认 20MB
MAX_UPLOAD_SIZE=20971520
# 扩展名白名单（逗号分隔，小写）：文档 + 图片 + 音频 + 视频（P5）
ALLOWED_EXTENSIONS=docx,doc,md,jpg,jpeg,png,webp,bmp,gif,mp3,wav,m4a,aac,flac,ogg,mp4,mov,m4v,avi,mkv,webm

# ---------- 多模态提交（P5 功能1） ----------
# 按类型分级的大小上限（字节）：图片 10MB / 音频 50MB / 视频 200MB
MAX_IMAGE_SIZE=10485760
MAX_AUDIO_SIZE=52428800
MAX_VIDEO_SIZE=209715200
# 是否校验文件头魔数与扩展名一致（挡住「改名伪装」的文件）
MEDIA_VERIFY_MAGIC=true
# 病毒扫描（可选，接 ClamAV clamd）。开启后为 fail-closed：
# clamd 不可达时**拒收**文件，避免「以为扫了其实没扫」。
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_HOST=127.0.0.1
VIRUS_SCAN_PORT=3310
VIRUS_SCAN_TIMEOUT=10

# ---------- 多模态解析（P5 功能2：OCR / ASR） ----------
# 总开关：关闭后图片/音视频仍可提交审核，但入库会明确失败（不静默跳过）
MEDIA_EXTRACT_ENABLED=true
# 多模态理解服务地址与 Key（留空则复用 QWEN_EMBEDDING_BASE_URL / QWEN_API_KEY）
MEDIA_LLM_BASE_URL=
MEDIA_LLM_API_KEY=
# 图片 OCR 模型（实测可用：qwen3.5-ocr；qwen-vl-ocr 只返回坐标框，不适合）
MEDIA_OCR_MODEL=qwen3.5-ocr
# 音频/视频转写模型（实测可用：qwen3.8-omni-flash，OpenAI 风格 input_audio）
MEDIA_ASR_MODEL=qwen3.8-omni-flash
# 单次多模态请求超时（秒）
MEDIA_EXTRACT_TIMEOUT=180
# 图片送模型前的最长边（像素）与 JPEG 质量（控制请求体体积）
MEDIA_IMAGE_MAX_EDGE=1600
MEDIA_IMAGE_JPEG_QUALITY=85
# 长音频按时长切片转写：单段秒数与最大段数（40×300s ≈ 3.3 小时上限）
MEDIA_ASR_SEGMENT_SECONDS=300
MEDIA_ASR_MAX_SEGMENTS=40
# 视频抽帧 OCR（默认关闭：每帧一次模型调用，费用与时延成倍）
MEDIA_VIDEO_OCR_ENABLED=false
MEDIA_VIDEO_OCR_INTERVAL=60
# ffmpeg 路径：留空/ffmpeg 时优先用 PATH，其次用 imageio-ffmpeg 自带二进制
MEDIA_FFMPEG_BIN=ffmpeg
# 媒体入库任务专用 Celery 队列（独立 worker 消费，避免长视频拖慢文档入库）
CELERY_MEDIA_QUEUE=media
