# Docker Compose 环境变量示例（本目录 docker/ 内使用）
# 用法：cp .env.example .env，然后填入真实 Key。
#
# 说明：docker-compose.yml 会自动读取同目录 .env 作为变量源，
#       ${DEEPSEEK_API_KEY:-} 从中取 DEEPSEEK_API_KEY 注入 backend 容器。

# DeepSeek API Key（必填才能真正问答；缺省为空时服务可正常启动，
# 但 /chat 会返回「未配置」提示，不影响页面浏览与文档上传）。
# 可填 backend/.env 中已配置的真实 Key。
DEEPSEEK_API_KEY=

# ---------- P2-B2：JWT 签名密钥（生产部署必填） ----------
# 用于签发与校验登录令牌。⚠️ 必须使用随机长密钥（≥32 字节），
# 否则 docker-compose.https.yml 会因变量缺失直接拒绝启动（防误用占位值）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ---------- P3/P5：通义千问（向量 / 多模态） ----------
QWEN_API_KEY=
QWEN_EMBEDDING_BASE_URL=
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
MEDIA_OCR_MODEL=qwen3.5-ocr
MEDIA_ASR_MODEL=qwen3.8-omni-flash

# =====================================================================
# P7 生产加固（监控 / 日志 / 备份 / 合规）
# =====================================================================

# ---------- 错误上报（Sentry） ----------
# DSN 留空 = 完全关闭（私有化部署默认不往外发数据）
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ---------- LLM 限流与配额 ----------
LLM_RATE_LIMIT_PER_MINUTE=20
LLM_RATE_LIMIT_PER_DAY=300
LLM_DAILY_TOKEN_QUOTA=200000

# ---------- 监控指标 ----------
# 抓取令牌：非空时 /metrics 需 Bearer 或 ?token=；公网暴露务必设置，
# 并同步填到 docker/prometheus/prometheus.yml 的 authorization.credentials
METRICS_TOKEN=

# Grafana 初始管理员密码（首次启动生效）
GRAFANA_ADMIN_PASSWORD=admin

# ---------- 数据不出域（合规） ----------
# standard=仅记录不拦截（公有云）；strict=白名单强制（私有化/等保）
DATA_RESIDENCY_MODE=standard
# strict 模式下允许出站的域名，逗号分隔（.aliyuncs.com 覆盖全部子域）
OUTBOUND_ALLOWED_HOSTS=

# ---------- 审计日志 ----------
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=180

# ---------- 备份 ----------
# 应用内置 Celery beat 是否启用备份（容器化另用 docker-compose.backup.yml 的 backup 容器）
BACKUP_ENABLED=false
# backup 容器保留策略
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_COUNT=30
BACKUP_HOUR=3
